# Root environment reference
#
# This file documents every variable the project reads. Actual values belong in
# `backend/.env` (server) and `frontend/.env` (build-time). Copy the relevant
# sections into those files — nothing reads this file directly.

# =============================================================================
# BACKEND  →  backend/.env
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# SQLite (default). Relative paths resolve against backend/prisma/.
DATABASE_URL="file:./dev.db"
# PostgreSQL — also set `provider = "postgresql"` in backend/prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/ai_scholarship_copilot?schema=public"

# ---- Security (REQUIRED in production) ----
# The server refuses to start if JWT_SECRET is unset or under 32 chars when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated emails granted ADMIN rights: catalogue writes, verification queue,
# manual review, deadline sweep and the automation console. Without this, no account
# can reach those routes.
ADMIN_EMAILS="admin@example.com"

# ---- CORS ----
FRONTEND_URL="http://localhost:5173"
# Optional explicit allowlist (comma-separated); defaults to FRONTEND_URL.
# CORS_ORIGINS="http://localhost:5173,https://app.example.com"

# Enable only behind a reverse proxy / load balancer, so client IPs (and therefore
# rate limiting) are read from X-Forwarded-For.
TRUST_PROXY=false

# ---- AI ----
# Optional. Unset means every AI feature falls back to its deterministic engine —
# the app remains fully functional with no external calls.
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# ---- Automation scheduler ----
# Runs the 10 in-app workflows on intervals. Set false on additional replicas so
# only one instance schedules work.
AUTOMATION_ENABLED=true

# ---- Rate limits (max requests per window) ----
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_AI_MAX=12

# ---- Logging / limits ----
LOG_LEVEL=debug
JSON_BODY_LIMIT=256kb

# Seed-only: email of the admin account created by `npm run prisma:seed`.
SEED_ADMIN_EMAIL="admin@example.com"

# ---- Transactional email (Resend) ----
# Preferred transport for every ScholarAI email: welcome, password reset, scholarship
# match, deadline reminder and application update. Tried before SMTP; on failure it
# falls back to SMTP, then to logging. Email failures never fail the request that
# triggered them.
#
# Manual setup: create a key at https://resend.com/api-keys, then verify your sending
# domain at https://resend.com/domains. RESEND_FROM_EMAIL must be on a verified domain.
# Both the key AND the from-address are required for Resend to be used.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME="ScholarAI"
RESEND_REPLY_TO=""

# SMTP is the fallback transport. Without either, notifications are logged, not sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ScholarAI <no-reply@localhost>"

# ---- Error reporting (Sentry) ----
# Blank DSN = Sentry stays completely inert (no outbound calls, all captures no-op).
# Manual setup: Sentry → Project Settings → Client Keys (DSN).
#
# Passwords, JWTs, API keys, request bodies and CV/SOP document text are stripped
# before any event leaves the process; only the user id is attached, never the email.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=development
# Defaults to scholarai@$APP_VERSION.
SENTRY_RELEASE=""
# 0 disables performance tracing; 0.1 = 10% of transactions.
# Defaults to 0.1 in production, 0 elsewhere.
SENTRY_TRACES_SAMPLE_RATE=0

# ---- API documentation ----
# Swagger UI at /api/docs, raw OpenAPI spec at /api/docs.json.
API_DOCS_ENABLED=true
APP_VERSION=1.0.0

# =============================================================================
# FRONTEND  →  frontend/.env   (inlined at BUILD time, not runtime)
# =============================================================================

# Leave unset to use the relative "/api" path — correct for local dev (Vite proxy)
# and for same-origin deployments behind a reverse proxy.
# Set an absolute URL only when the SPA is hosted separately from the API.
# VITE_API_URL="https://api.your-domain.com/api"

# ---- Error reporting (Sentry, browser) ----
# Separate DSN from the backend: use a Sentry project of platform "React".
# Blank = disabled. This value ships in the client bundle, which is expected for a
# browser DSN (it only permits event ingestion), but it is NOT the backend DSN.
# VITE_SENTRY_DSN="https://<key>@o0.ingest.sentry.io/0"
VITE_SENTRY_ENVIRONMENT=development
# Defaults to scholarai-frontend@$VITE_APP_VERSION.
# VITE_SENTRY_RELEASE=""
# 0 disables tracing; 0.1 = 10% of page loads/navigations.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_VERSION=1.0.0

