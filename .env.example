# Root environment reference
#
# This file documents every variable the project reads. Actual values belong in
# `backend/.env` (server) and `frontend/.env` (build-time). Copy the relevant
# sections into those files — nothing reads this file directly.

# =============================================================================
# BACKEND  →  backend/.env
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# SQLite (default). Relative paths resolve against backend/prisma/.
DATABASE_URL="file:./dev.db"
# PostgreSQL — also set `provider = "postgresql"` in backend/prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/ai_scholarship_copilot?schema=public"

# ---- Security (REQUIRED in production) ----
# The server refuses to start if JWT_SECRET is unset or under 32 chars when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated emails granted ADMIN rights: catalogue writes, verification queue,
# manual review, deadline sweep and the automation console. Without this, no account
# can reach those routes.
ADMIN_EMAILS="admin@example.com"

# ---- CORS ----
FRONTEND_URL="http://localhost:5173"
# Optional explicit allowlist (comma-separated); defaults to FRONTEND_URL.
# CORS_ORIGINS="http://localhost:5173,https://app.example.com"

# Enable only behind a reverse proxy / load balancer, so client IPs (and therefore
# rate limiting) are read from X-Forwarded-For.
TRUST_PROXY=false

# ---- AI ----
# Optional. Unset means every AI feature falls back to its deterministic engine —
# the app remains fully functional with no external calls.
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# ---- Automation scheduler ----
# Runs the 10 in-app workflows on intervals. Set false on additional replicas so
# only one instance schedules work.
AUTOMATION_ENABLED=true

# ---- Rate limits (max requests per window) ----
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_AI_MAX=12

# ---- Logging / limits ----
LOG_LEVEL=debug
JSON_BODY_LIMIT=256kb

# Seed-only: email of the admin account created by `npm run prisma:seed`.
SEED_ADMIN_EMAIL="admin@example.com"

# =============================================================================
# FRONTEND  →  frontend/.env   (inlined at BUILD time, not runtime)
# =============================================================================

# Leave unset to use the relative "/api" path — correct for local dev (Vite proxy)
# and for same-origin deployments behind a reverse proxy.
# Set an absolute URL only when the SPA is hosted separately from the API.
# VITE_API_URL="https://api.your-domain.com/api"
