{
  "name": "ai-scholarship-copilot-backend",
  "version": "1.0.0",
  "description": "Backend API service for AI Scholarship Copilot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 202",
    "lint:strict": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "check:duplicates": "ts-node src/scripts/checkDuplicates.ts",
    "check:email": "ts-node src/scripts/checkEmail.ts",
    "test": "npm run test:all",
    "test:all": "ts-node src/tests/runAll.ts",
    "test:journeys": "ts-node src/tests/userJourneyTest.ts",
    "test:auth": "ts-node src/tests/authAndProfileTest.ts",
    "test:explorer": "ts-node src/tests/scholarshipExplorerTest.ts",
    "test:matching": "ts-node src/tests/matchingEligibilityTest.ts",
    "test:chatbot": "ts-node src/tests/chatbotOrchestratorTest.ts",
    "test:documents": "ts-node src/tests/cvAndSOPAssistanceTest.ts",
    "test:applications": "ts-node src/tests/applicationAndDeadlineAutomationTest.ts",
    "test:verification": "ts-node src/tests/scholarshipVerificationAgentTest.ts",
    "test:discovery": "ts-node src/tests/externalDiscoveryTest.ts",
    "probe:search": "ts-node src/scripts/probeSearchProvider.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.33.0",
    "pdf-parse": "^1.1.1",
    "resend": "^6.21.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  }
}
