{
  "name": "ai-scholarship-copilot-backend",
  "version": "1.0.0",
  "description": "Backend API service for AI Scholarship Copilot",
  "main": "dist/index.js",
  "scripts": {
    "build": "node_modules\\.bin\\tsc",
    "start": "node dist/index.js",
    "dev": "node_modules\\.bin\\ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "node_modules\\.bin\\tsc --noEmit",
    "prisma:generate": "node_modules\\.bin\\prisma generate",
    "prisma:push": "node_modules\\.bin\\prisma db push",
    "prisma:migrate": "node_modules\\.bin\\prisma migrate dev",
    "prisma:deploy": "node_modules\\.bin\\prisma migrate deploy",
    "prisma:status": "node_modules\\.bin\\prisma migrate status",
    "prisma:studio": "node_modules\\.bin\\prisma studio",
    "prisma:seed": "node_modules\\.bin\\ts-node src/prisma/seed.ts",
    "check:duplicates": "node_modules\\.bin\\ts-node src/scripts/checkDuplicates.ts",
    "test:journeys": "node_modules\\.bin\\ts-node src/tests/userJourneyTest.ts",
    "test:discovery": "node_modules\\.bin\\ts-node src/tests/externalDiscoveryTest.ts",
    "probe:search": "node_modules\\.bin\\ts-node src/scripts/probeSearchProvider.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.33.0",
    "pdf-parse": "^1.1.1",
    "resend": "^6.21.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
