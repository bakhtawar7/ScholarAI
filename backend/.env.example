# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Relative SQLite paths resolve against the prisma/ directory (so this is backend/prisma/dev.db).
# For PostgreSQL, also change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_scholarship_copilot?schema=public"

# ---- Security ----
# REQUIRED in production. Must be >= 32 characters; the server refuses to boot without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated emails granted ADMIN rights (catalogue writes, verification, automation).
ADMIN_EMAILS="admin@example.com"

# ---- CORS ----
FRONTEND_URL="http://localhost:5173"
# Optional explicit allowlist; defaults to FRONTEND_URL.
# CORS_ORIGINS="http://localhost:5173,https://app.example.com"

# Set true only when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# ---- AI ----
# Leave blank to run entirely on the deterministic engines (no external calls).
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini

# ---- Automation scheduler ----
# Set false to run the API without background workflows (e.g. on a second replica).
AUTOMATION_ENABLED=true

# ---- Rate limits (requests per window) ----
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_AI_MAX=12

# ---- Logging ----
LOG_LEVEL=debug
JSON_BODY_LIMIT=256kb

# ---- External scholarship discovery (EXTERNAL-FIRST search) ----
# Discovery searches real external sources BEFORE touching the database. The database is
# a cache / knowledge base, never the primary source for a fresh discovery request.
#
# Providers are tried as a CHAIN, in order, until one returns results. A quota-exhausted
# or unconfigured primary therefore falls through to the next provider instead of
# silently downgrading the answer to a database-only result.
#
# Provider options (set SCHOLARSHIP_SEARCH_PROVIDER to force one to the front):
#   serper  - https://serper.dev            (Google SERP API)          — best quality
#   tavily  - https://tavily.com            (LLM-oriented; page text)  — best extraction
#   brave   - https://brave.com/search/api
#   gemini  - Google Search grounding via your existing Gemini key. No extra signup,
#             but note grounding has its OWN quota: free-tier keys commonly return
#             HTTP 429 on this feature even while normal chat calls still work.
# Leave blank to auto-detect. A dedicated key is always preferred.
SCHOLARSHIP_SEARCH_PROVIDER=""
SCHOLARSHIP_SEARCH_API_KEY=""
# Override only for self-hosted/proxied endpoints.
SCHOLARSHIP_SEARCH_API_URL=""
# Model used for grounded search; defaults to LLM_MODEL.
SCHOLARSHIP_SEARCH_MODEL=""

# Keyless SERP fallback (DuckDuckGo HTML endpoint), tried LAST in the chain. This is what
# keeps live discovery working with no API key at all. It is rate limited by the host, so
# for production traffic configure one of the keyed providers above.
SCHOLARSHIP_SEARCH_ALLOW_KEYLESS=true

# Set false to disable live discovery and answer from the stored catalogue only.
EXTERNAL_DISCOVERY_ENABLED=true
SEARCH_TIMEOUT_MS=20000
# Spacing and retry backoff for the keyless provider (it answers bursts with HTTP 202).
SEARCH_QUERY_DELAY_MS=1200
SEARCH_THROTTLE_BACKOFF_MS=2500

# ---- Source page retrieval (feeds AI extraction) ----
# Fetches the provider's own page so extraction reads real page text rather than a search
# snippet. robots.txt is fetched and honoured per origin (including Crawl-delay); pages
# that are disallowed, access-gated (401/403) or rate limited (429) are SKIPPED, never
# worked around. Set false to extract from snippets only.
DISCOVERY_FETCH_PAGES=true
DISCOVERY_MAX_PAGES=5
# Distinct search phrasings issued per discovery request (each is one outbound request).
DISCOVERY_MAX_QUERIES=3
PAGE_FETCH_TIMEOUT_MS=12000
PAGE_FETCH_MAX_BYTES=900000
PAGE_FETCH_DELAY_MS=1000

# ---- Verification ----
# Live HTTP reachability checks on official URLs. Disable in offline/CI environments.
URL_CHECK_ENABLED=true
URL_CHECK_TIMEOUT_MS=8000

# ---- Data retention ----
# Days to keep raw CV document text. Analysis results are kept; only the source
# document is redacted. 0 disables purging.
CV_RETENTION_DAYS=90

# ---- Notification delivery (SMTP) ----
# Legacy/fallback transport. Resend below is preferred when configured; without either,
# notifications are logged rather than emailed and the dispatch workflow reports
# channel "log" so nothing implies delivery that did not happen.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ScholarAI <no-reply@localhost>"

# ---- Transactional email (Resend) ----
# Preferred transport for all ScholarAI email: welcome, password reset, scholarship
# match, deadline reminder and application update. Tried before SMTP; if Resend fails,
# delivery falls back to SMTP, then to logging. Leave blank to keep the previous
# SMTP-or-log behaviour unchanged.
#
# Setup: create a key at https://resend.com/api-keys, then verify the sending domain at
# https://resend.com/domains. RESEND_FROM_EMAIL must be on a verified domain — Resend
# rejects anything else. Until a domain is verified, onboarding@resend.dev works but can
# only deliver to your own account address.
#
# BOTH the key and the from-address are required. With a key but no from-address the
# service logs a warning and falls back to SMTP.
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="bakhtawarfatima34q@gmail.com"
RESEND_FROM_NAME="ScholarAI"
# Optional Reply-To on outbound mail (e.g. a monitored support inbox).
RESEND_REPLY_TO=""

# ---- Error reporting (Sentry) ----
# Leave SENTRY_DSN blank to keep Sentry completely inert: no outbound calls, every
# capture helper a no-op. Get the DSN from Sentry → Project Settings → Client Keys (DSN).
#
# Request bodies, headers like Authorization/Cookie, JWTs, passwords, API keys and
# CV/SOP document text are stripped before any event is sent. Only the user id is
# attached for triage — never the email or profile.
SENTRY_DSN=""
# Defaults to NODE_ENV. Set explicitly to separate staging from production.
SENTRY_ENVIRONMENT=development
# Groups errors by deployed version. Defaults to scholarai@$APP_VERSION.
SENTRY_RELEASE=""
# Share of transactions traced for performance monitoring. 0 disables tracing;
# 0.1 = 10%. Defaults to 0.1 in production and 0 elsewhere. Keep it low — every
# sampled transaction counts against the Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0

# ---- API documentation ----
# Swagger UI at /api/docs and the raw spec at /api/docs.json.
# Set false to serve neither in a locked-down deployment.
API_DOCS_ENABLED=true
# Reported by /api/health and used as the Sentry release and the OpenAPI version.
APP_VERSION=1.0.0

