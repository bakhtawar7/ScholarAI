# Base URL of the backend API.
#
# Leave unset (or empty) to use the relative "/api" path — correct for local dev via the
# Vite proxy, and for any deployment where the SPA and API share an origin behind a
# reverse proxy.
#
# Set an absolute URL when the frontend is hosted separately from the backend
# (e.g. static hosting + a separate API host). The value is inlined at build time,
# so it must be set before `npm run build`, not at runtime.
#
# VITE_API_URL="https://api.your-domain.com/api"
